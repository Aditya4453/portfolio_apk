{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-backend.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets|favicon|icons|hero_photo|AM_Resume).*)",
      "destination": "/index.html"
    }
  ]
}
